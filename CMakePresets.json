{
    "version": 4,
    "configurePresets": [
        {
            "name": "ucrt64 without UI",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
                "BARRIER_BUILD_GUI": "no",
                "BARRIER_BUILD_TESTS": "no",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "mingw32-x86",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-x86",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "C:/msys64/mingw32/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/mingw32/bin/g++.exe",
                "BARRIER_BUILD_GUI": "no",
                "BARRIER_BUILD_TESTS": "no",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "OPENSSL_ROOT_DIR": "C:/msys64/mingw32"
            }
        },
        {
            "name": "msvc-x64-release",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build-msvc-x64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BARRIER_BUILD_GUI": "no",
                "BARRIER_BUILD_TESTS": "no",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-x64-release",
            "configurePreset": "msvc-x64-release",
            "configuration": "Release"
        }
    ]
}